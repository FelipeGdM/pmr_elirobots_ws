{
    "name": "ROS 2 Linux Lyrical",
    "dockerComposeFile": "docker-compose.yml",
    "service": "ros",
    "workspaceFolder": "/home/rosbot/ws",
    "remoteUser": "rosbot",
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "redhat.vscode-yaml",
                "ranch-hand-robotics.rde-ros-2",
                "detachhead.basedpyright",
                "xaver.clang-format",
                "charliermarsh.ruff",
                "redhat.vscode-xml",
                "tamasfe.even-better-toml",
                "ms-azuretools.vscode-docker"
            ]
        }
    },
    "postCreateCommand": "sudo rosdep update && sudo rosdep install --from-paths src --ignore-src -y && sudo chown -R $(whoami) /home/rosbot/ws/"
}
